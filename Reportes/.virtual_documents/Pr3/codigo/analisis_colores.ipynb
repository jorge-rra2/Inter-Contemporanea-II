import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit

# ============================================================
# Cargar datos
# ============================================================

df = pd.read_csv("../datos/ccd_y_leds_limpio.csv")

V = df["V_AK_V"].to_numpy()
sigma_V = df["u_V_AK_V"].to_numpy()

nu_Hz = df["nu_Hz"].to_numpy()
nu_THz = nu_Hz / 1e12


# ============================================================
# Ajuste lineal
#
# Modelo físico:
#
#     nu = (e/h) V_AK + b
#
# Como nu está en THz:
#
#     m = e/h       en THz/V
#
# y, por tanto:
#
#     h/e = 1e-12 / m       en V s
# ============================================================

def modelo(V, m, b):
    return m * V + b


popt, pcov = curve_fit(
    modelo,
    V,
    nu_THz
)

m, b = popt
sigma_m, sigma_b = np.sqrt(np.diag(pcov))


# ============================================================
# Cálculo de h/e
# ============================================================

# m está en THz/V.
# Al convertir THz a Hz:
#
#     m_Hz = m * 1e12
#
# Por tanto:
#
#     h/e = 1 / m_Hz = 1e-12 / m

h_sobre_e_exp = 1e-12 / m

# Propagación de incertidumbre:
#
#     u(h/e) = |d(h/e)/dm| u_m
#            = (1e-12 / m^2) u_m

u_h_sobre_e_exp = 1e-12 * sigma_m / m**2


# Valor aceptado
h_sobre_e_teo = 4.135667696e-15  # V s

error_porcentual = (
    (h_sobre_e_exp - h_sobre_e_teo)
    / h_sobre_e_teo
    * 100
)

error_relativo = abs(error_porcentual)


# ============================================================
# Coeficiente de determinación R^2
# ============================================================

nu_fit = modelo(V, m, b)

ss_res = np.sum((nu_THz - nu_fit)**2)
ss_tot = np.sum((nu_THz - np.mean(nu_THz))**2)

R2 = 1 - ss_res / ss_tot


# ============================================================
# Resultados
# ============================================================

print("========== Ajuste lineal ==========")
print(f"m = ({m:.6e} ± {sigma_m:.6e}) THz/V")
print(f"b = ({b:.6f} ± {sigma_b:.6f}) THz")
print(f"R^2 = {R2:.6f}")

print("\n========== Resultado para h/e ==========")
print(
    "h/e experimental = "
    f"({h_sobre_e_exp:.6e} ± "
    f"{u_h_sobre_e_exp:.6e}) V s"
)
print(f"h/e aceptado     = {h_sobre_e_teo:.6e} V s")
print(f"Diferencia porcentual = {error_porcentual:.2f} %")
print(f"Error relativo        = {error_relativo:.2f} %")





# ============================================================
# Gráfica: frecuencia nu contra voltaje V_AK
# ============================================================

V_grid = np.linspace(V.min(), V.max(), 300)
nu_grid = modelo(V_grid, m, b)

plt.figure(figsize=(7, 5))

plt.errorbar(
    V,
    nu_THz,
    xerr=sigma_V,
    fmt="o",
    capsize=3,
    label="Datos"
)

plt.plot(
    V_grid,
    nu_grid,
    label=(
        fr"Ajuste: $\nu="
        fr"({m:.3f})V_{{AK}}"
        fr"{b:+.3f}$"
    )
)

plt.xlabel(r"$V_{AK}$ [V]")
plt.ylabel(r"$\nu$ [THz]")

plt.grid(True)
plt.legend()
plt.tight_layout()

plt.savefig(
    "graf_colores.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()



